# 复制本文件为 .env 并填入你自己的配置（.env 不会被提交/打包）
#   cp .env.example .env

# 必填：OpenAI 兼容的 LLM 端点
LLM_BASE_URL=https://your-endpoint/v1
LLM_API_KEY=sk-your-key
LLM_MODEL=your-model-name

# 可选：评测打分用的模型（不填则同 LLM_MODEL）
# JUDGE_MODEL=

# 可选：本地 cross-encoder 重排（T5）。首次运行会自动从 HF 镜像下载。
# 不需要重排就留空/注释。
RERANK_MODEL_NAME=BAAI/bge-reranker-base

# 可选：模型已缓存后设 1，启动时不再联网探测（网络不稳时更快）
# RAG_OFFLINE=1
